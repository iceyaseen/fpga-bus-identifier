# KiCad's own local-history repo (auto-created, no remote, just editor undo history)
PCB/PCB_board_and_schematic/.history

# KiCad backup/autosave files
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_prl-bak
_autosave-*
*.lck
fp-info-cache

# FPGA toolchain build output (Yosys synthesis + nextpnr place & route +
# Gowin pack, regenerated by the Lushay Code build). Named after the
# project's "top" module, per top.lushay.json - NOT a broad *.json rule,
# so top.lushay.json itself stays tracked.
impl/
top.fs
top.json
top_pnr.json
*_pnr.json

# Icarus Verilog compiled simulation binaries - regenerated by `iverilog`
*.vvp
uart_sim

# Simulation waveform dumps - regenerated on every testbench run
*.vcd

# Python bytecode cache
__pycache__/
*.pyc

# host.py capture logs - local test data, not project source
capture_*.csv
